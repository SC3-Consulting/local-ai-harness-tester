# Copy to .env and edit. Every value is optional; command-line flags win over this file.
# Real environment variables win over this file too. .env is ignored by Git.

# Which server to tune: ollama or llama.cpp
TUNER_RUNTIME=ollama
TUNER_MODEL=llama3.2:1b
# TUNER_ENDPOINT=http://127.0.0.1:11434

# llama.cpp only: how the tuner starts the server. {ctx} is filled in for each context size.
# Placeholders: {ctx} {port} {host} {model}. Run as an argument list, not through a shell.
# Give the full path to llama-server if it is not on PATH.
# TUNER_SERVER_CMD=llama-server -m {model} -c {ctx} --parallel 1 --no-cache-prompt --host {host} --port {port}
# TUNER_SERVER_START_TIMEOUT=180

# Context search
TUNER_MIN_CTX=2048
# Leave empty to use what the model advertises (capped by TUNER_HARD_CTX_CAP).
# TUNER_MAX_CTX=16384
TUNER_HARD_CTX_CAP=65536
# down = start at the maximum and halve; up = start small and double (gentler on small RAM)
TUNER_CTX_STRATEGY=down

# Prompt and reply sizes
TUNER_MAX_TOKENS=200
TUNER_TOKENS_PER_WORD=1.5
TUNER_BUFFER=0.10

# Pass criterion: 0 = the reply completed; 1 = valid JSON object with a summary key
TUNER_MIN_SCORE=0
# Ask the server to constrain replies to well-formed JSON (Ollama, llama.cpp)
TUNER_JSON_MODE=0
# Stream replies to record time to first token and decode speed
TUNER_TTFT=1

# Safety limits for one run
TUNER_TIMEOUT=300
TUNER_MAX_PROBES=80
TUNER_MAX_MINUTES=240
TUNER_MIN_FREE_MEM_MB=300
TUNER_MIN_FREE_DISK_MB=1024

# Where run folders are written, and the text the prompts are cut from
TUNER_OUTPUT_DIR=tuning_runs
# TUNER_CORPUS=examples/moby_dick.txt
TUNER_LOG_LEVEL=INFO
